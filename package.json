    "./openai-agents": "./adapters/openai-agents.mjs",
    "./mcp": "./adapters/mcp.mjs"
  },
  "files": [
    "runtime",
    "adapters",
    "profiles",
    "README.md",
    "SECURITY.md",
    "docs",
    "LICENSE"
  ],
