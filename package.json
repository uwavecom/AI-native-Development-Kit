  "description": "Portable action governance for AI agents: trusted approvals, policy provenance, verification, recovery, and framework adapters.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uwavecom/AI-native-Development-Kit.git"
  },
  "bugs": {
    "url": "https://github.com/uwavecom/AI-native-Development-Kit/issues"
  },
  "homepage": "https://github.com/uwavecom/AI-native-Development-Kit#readme",
  "keywords": [
    "ai-agents",
    "agentic",
    "governance",
    "approvals",
