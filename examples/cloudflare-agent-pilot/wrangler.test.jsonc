{
  "name": "kit-cloudflare-agent-pilot-test",
  "main": "agent.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{"name": "TaskAgent", "class_name": "TaskAgent"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["TaskAgent"]}],
  "vars": {
    "PILOT_SIGNING_SECRET": "integration-test-only-signing-secret-2026",
    "PILOT_CALLER_TOKEN": "integration-test-only-caller-token-2026"
  }
}
